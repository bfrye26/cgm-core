{
  "apiVersion": 3,
  "name": "cgm-core/dynamic-value",
  "title": "CGM Dynamic Value",
  "category": "theme",
  "icon": "database",
  "description": "Render any CGM Core dynamic-data path for the current query object.",
  "supports": {
    "html": false
